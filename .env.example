# ============================================================================
# RPG-Cloud — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================================

# Database Configuration
DB_ROOT_PASSWORD=change_me_root
DB_NAME=rpg_cloud_db
DB_USER=rpg_user
DB_PASSWORD=change_me

# CORS (comma-separated origins allowed by the backend)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80

# JWT Authentication
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars!
JWT_EXPIRATION_MS=86400000
